# Copy this file to .env and fill in real values. Never commit .env.
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_SECRET_FILE=secrets/client_secret.json
GOOGLE_TOKEN_FILE=secrets/google-token.json
GOOGLE_CALENDAR_ID=profitlenstemplate@gmail.com
FOUNDER_NOTIFY_EMAIL=ioseb@useprofitlens.com,profitlenstemplate@gmail.com

# Call booking hours, in founders' time (Georgia, GMT+4). End past midnight is allowed.
BOOKING_TIMEZONE=Asia/Tbilisi
BOOKING_DAYS=mon,tue,wed,thu,fri,sat,sun
BOOKING_START=19:00
BOOKING_END=03:00

# Cost and abuse protection
CLAUDE_MODEL=claude-sonnet-5
DAILY_SPEND_LIMIT_USD=5
MAX_REPLY_TOKENS=400
MAX_MESSAGE_CHARS=1000
SESSION_MESSAGES_PER_HOUR=20
MAX_VISITOR_MESSAGES_PER_SESSION=30
IP_RATE_LIMIT=60/hour

# Founder alerts in Telegram (Phase 2). The bot token is a secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1004318522269

# Local test pages (never on in production)
TEST_PAGES=0
